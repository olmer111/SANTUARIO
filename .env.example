# === SANTUARIO — variables de entorno ===
# Copia este archivo a .env y completa los valores. Nunca subas .env al repo.

# Base de datos (docker compose levanta Postgres con estos valores)
DATABASE_URL="postgresql://santuario:santuario@localhost:5432/santuario"

# Redis (colas BullMQ)
REDIS_URL="redis://localhost:6379"

# Media engine (FastAPI: TTS, Whisper, FFmpeg)
MEDIA_ENGINE_URL="http://localhost:8001"

# Cerebro de agentes — costo cero primero: NVIDIA NIM (cloud, gratis, sin GPU local)
# https://build.nvidia.com — free tier con modelos abiertos (Llama, Nemotron…)
LLM_PROVIDER="nvidia"
NVIDIA_API_KEY=""
# Alternativa de mayor calidad (de pago) para partes críticas del pipeline
ANTHROPIC_API_KEY=""

# Proveedores de video (se agregan en Fase 2; también viven cifrados en la tabla providers)
HIGGSFIELD_API_KEY=""
FAL_API_KEY=""
REPLICATE_API_TOKEN=""
HF_TOKEN=""

# Storage local (MVP; S3-compatible después)
STORAGE_DIR="./storage"
